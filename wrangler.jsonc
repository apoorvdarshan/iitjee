{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iitjee",
  "compatibility_date": "2026-07-10",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "pcm-notes.apoorvdarshan.com",
      "custom_domain": true
    },
    // The site's old address. A Cloudflare Redirect Rule on the zone sends it to
    // pcm-notes.apoorvdarshan.com with a 301 before it reaches this Worker; the
    // custom domain stays so its DNS record does.
    {
      "pattern": "iitjee.apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
