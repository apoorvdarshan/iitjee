{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iitjee",
  "compatibility_date": "2026-07-11",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "iitjee.apoorvdarshan.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
